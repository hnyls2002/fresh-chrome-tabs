{
  "manifest_version": 3,
  "name": "Fresh Tabs",
  "version": "0.1.0",
  "description": "Finds duplicate tabs, shows what would close, and closes them on one click. Matching rules are configurable per site.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Fresh Tabs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
